# ============================================================
# GymFlow Environment Variables Template
# ============================================================

# Database (PostgreSQL)
# Pooled connection string (used by app runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymflow?schema=public&pgbouncer=true"
# Direct connection string (used by Prisma migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gymflow?schema=public"

# NextAuth / Auth.js Authentication
AUTH_SECRET="production-secret-must-be-at-least-32-chars-long"
NEXTAUTH_SECRET="production-secret-must-be-at-least-32-chars-long"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://your-app.vercel.app"

# OAuth Providers (Optional in local development)
GOOGLE_CLIENT_ID="mock-google-client-id"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"

# AI Provider (Server-side only)
OPENAI_API_KEY="mock-openai-api-key"
# GOOGLE_GENERATIVE_AI_API_KEY=""

# External Exercise API (Server-side only)
EXERCISE_API_KEY="mock-exercise-api-key"

# Web Push (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="mock-vapid-public-key"
VAPID_PRIVATE_KEY="mock-vapid-private-key"
VAPID_SUBJECT="mailto:admin@gymflow.local"

# Rate Limiting (Upstash Redis - Optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
